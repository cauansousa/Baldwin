# Configuration for scripts/deploy-testnet.ts (Arbitrum Sepolia).
# Copy to contracts/.env (git-ignored) and fill in. Never commit a private key.

# --- network -----------------------------------------------------------------
# RPC endpoint of Arbitrum Sepolia (chain id 421614), e.g. from your node provider.
ARBITRUM_SEPOLIA_RPC_URL=
# Private key of the deploying account (0x + 64 hex). It needs a little Sepolia ETH on
# Arbitrum Sepolia. It becomes the temporary owner until the multisig accepts ownership.
DEPLOYER_PRIVATE_KEY=
# Etherscan API key (API v2, also valid for Arbiscan); only needed for `hardhat verify`.
ETHERSCAN_API_KEY=

# --- external contracts (look these up, do not guess) --------------------------
# Testnet USDC on Arbitrum Sepolia: see Circle's "USDC on test networks" page.
USDC_ADDRESS=
# Chainlink price feeds on Arbitrum Sepolia: see Chainlink's "Price Feed Contract
# Addresses" list (docs.chain.link), network "Arbitrum Sepolia". Use the proxy addresses.
BTC_USD_FEED=
ETH_USD_FEED=
# Maximum age in seconds accepted for each feed: the heartbeat shown in the same list
# plus a margin (e.g. heartbeat 3600 -> 3900).
BTC_USD_MAX_STALENESS=
ETH_USD_MAX_STALENESS=
# Optional: Chainlink "L2 Sequencer Uptime Feed" for Arbitrum Sepolia (docs.chain.link,
# "L2 Sequencer Uptime Feeds"). Leave empty to disable the check.
SEQUENCER_UPTIME_FEED=
# Seconds after the sequencer comes back during which prices are still rejected.
SEQUENCER_GRACE_PERIOD=3600

# --- roles ---------------------------------------------------------------------
# Final owner (multisig). Ownership is transferred in two steps: after the script has
# run, the multisig must call acceptOwnership() on the Exchange and on the ChainlinkOracle.
OWNER_ADDRESS=
# The script refuses an owner without contract code unless this is "true".
ALLOW_EOA_OWNER=false
# Account the matching engine signs settleMatches with.
OPERATOR_ADDRESS=
# Account credited with trading fees.
FEE_RECIPIENT=

# --- exchange parameters (defaults shown) ----------------------------------------
# Global maximum oracle price age in seconds. Default: the larger of the two
# *_MAX_STALENESS values.
MAX_PRICE_AGE=
# Funding rate cap, bps per hour (at most 100).
MAX_FUNDING_RATE_BPS=10
# Fill price band around the index, bps. Must satisfy band + highest fee < maintenance margin.
MAX_PRICE_DEVIATION_BPS=500

# --- market parameters (defaults shown; apply to both markets unless prefixed) ----
INITIAL_MARGIN_BPS=2000
MAINTENANCE_MARGIN_BPS=1000
MAKER_FEE_BPS=2
TAKER_FEE_BPS=5
LIQUIDATION_PENALTY_BPS=150
# Base units, decimal.
BTC_MAX_OPEN_INTEREST=1000
BTC_MIN_ORDER_SIZE=0.001
ETH_MAX_OPEN_INTEREST=20000
ETH_MIN_ORDER_SIZE=0.01

# --- output ----------------------------------------------------------------------
# Optional: where to write the Deployment JSON. Default: deployments/<network>.json
DEPLOYMENT_FILE=
