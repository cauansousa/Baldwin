# Baldwin engine + keeper on Arbitrum Sepolia (chain id 421614).
# Copy to .env on the host (or load it through your process manager) and fill in the
# two keys. Everything not listed here keeps the defaults documented in .env.example.

# --- chain -------------------------------------------------------------------
# An HTTPS JSON-RPC endpoint for Arbitrum Sepolia. The public endpoint works but is
# rate-limited; a provider endpoint with your own key is strongly recommended.
RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
# Written by contracts/scripts/deploy-testnet.ts. The chain id is taken from this file
# and checked against the RPC at start-up.
DEPLOYMENT_PATH=../contracts/deployments/arbitrumSepolia.json

# --- engine ------------------------------------------------------------------
# Must be the operator set on the Exchange (OPERATOR_ADDRESS at deployment), must hold
# Arbitrum Sepolia ETH, and must be used by this process only.
OPERATOR_PRIVATE_KEY=
PORT=8080
# Listen on all interfaces only behind a reverse proxy / firewall.
HOST=127.0.0.1
# The web app's origin(s), comma separated.
CORS_ORIGIN=https://app.example.org
# true when running behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=true
STORE_PATH=data/engine-arbitrum-sepolia.sqlite

# Arbitrum produces a block roughly every 250 ms and has not had ordinary reorgs; a few
# blocks cost about a second and protect against the rare sequencer-side one.
CONFIRMATIONS=4
# Fees are EIP-1559, taken from the node. Arbitrum ignores the priority fee; the cap
# only limits what a stuck transaction may be bumped to.
MAX_FEE_PER_GAS_GWEI=5
# The gas limit comes from eth_estimateGas, which on Arbitrum includes the L1 data cost.
GAS_LIMIT_CAP=16000000
# Fallback for Exchange.sol's MATCH_GAS_BASE / MATCH_GAS_PER_MARKET (read on-chain when exposed).
MATCH_GAS_FLOOR_BASE=400000
MATCH_GAS_FLOOR_PER_MARKET=150000
RECEIPT_TIMEOUT_MS=15000
RECEIPT_POLL_MS=250
OPERATOR_MIN_BALANCE_ETH=0.02

# Index prices move with every Chainlink round; 1 s keeps the price band current.
CHAIN_REFRESH_MS=1000
LOG_POLL_INTERVAL_MS=2000
# Many providers limit eth_getLogs to 500-10000 blocks or a response size; the engine
# halves the range on its own when a query is refused.
LOG_MAX_BLOCK_RANGE=2000
# Block in which the Exchange was deployed: where the engine starts looking for
# on-chain cancels on its very first start. Later starts continue from the stored cursor.
START_BLOCK=

LOG_LEVEL=info

# --- keeper ------------------------------------------------------------------
# A different account than the operator. Needs ETH for gas and USDC deposited in the
# Exchange (a liquidator takes the position over and must margin it).
KEEPER_PRIVATE_KEY=
KEEPER_POLL_INTERVAL_MS=5000
# Block in which the Exchange was deployed.
KEEPER_START_BLOCK=
KEEPER_STATE_PATH=data/keeper-arbitrum-sepolia.json
# Warn at start-up below this many USDC units (6 decimals) of free collateral: 100 USDC.
KEEPER_MIN_FREE_COLLATERAL=100000000
