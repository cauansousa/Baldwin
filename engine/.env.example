# --- shared -----------------------------------------------------------------
# JSON-RPC endpoint of the chain the Exchange is deployed on.
RPC_URL=http://127.0.0.1:8545
# Deployment file written by contracts/scripts/deploy.ts (relative to engine/).
DEPLOYMENT_PATH=../contracts/deployments/localhost.json

# --- engine (npm run dev / npm start) ----------------------------------------
# Operator key: must be allowed by Exchange.isOperator and used by NO other process.
# Example below is Hardhat's well-known account #0. Never use it on a real network.
OPERATOR_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
PORT=8080
HOST=127.0.0.1
# Allowed CORS origin ("*" or e.g. http://localhost:5173).
CORS_ORIGIN=*
# Requests per minute per IP (REST) and new WebSocket connections per minute per IP.
RATE_LIMIT_PER_MINUTE=600
# Set to true only behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
# Max matches per settleMatches transaction.
MAX_BATCH_SIZE=20
# Check isCancelled / filledSize / position / freeCollateral on-chain at order intake.
PRETRADE_CHECKS=true
# Orders are treated as expired this many seconds before their expiry.
EXPIRY_BUFFER_SEC=5

# --- keeper (npm run keeper) --------------------------------------------------
# Must be a different account than the operator (Hardhat account #1 below).
KEEPER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
KEEPER_POLL_INTERVAL_MS=5000
FUNDING_INTERVAL_SEC=3600
# Block to start scanning Fill/Liquidation events from.
KEEPER_START_BLOCK=0
