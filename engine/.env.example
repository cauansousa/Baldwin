# --- shared -----------------------------------------------------------------
# JSON-RPC endpoint of the chain the Exchange is deployed on.
RPC_URL=http://127.0.0.1:8545
# Deployment file written by contracts/scripts/deploy.ts (relative to engine/).
DEPLOYMENT_PATH=../contracts/deployments/localhost.json

# --- engine (npm run dev / npm start) ----------------------------------------
# Operator key: must be allowed by Exchange.isOperator and used by NO other process.
# Example below is Hardhat's well-known account #0. Never use it on a real network.
OPERATOR_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
PORT=8080
HOST=127.0.0.1
# Allowed CORS origin ("*" or e.g. http://localhost:5173).
CORS_ORIGIN=*
# Requests per minute per IP (REST) and new WebSocket connections per minute per IP.
RATE_LIMIT_PER_MINUTE=600
# Set to true only behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
# Max matches per settleMatches transaction.
MAX_BATCH_SIZE=20
# Check isCancelled / filledSize / position / freeCollateral on-chain at order intake.
PRETRADE_CHECKS=true
# Orders must carry an expiry: at least MIN_TIME_TO_EXPIRY_SEC and at most
# MAX_TIME_TO_EXPIRY_SEC from now. Resting orders leave the book EXPIRY_BUFFER_SEC
# before their expiry so that a match cannot reach the chain too late.
MIN_TIME_TO_EXPIRY_SEC=60
MAX_TIME_TO_EXPIRY_SEC=604800
EXPIRY_BUFFER_SEC=30
# SQLite file with the engine's durable state: orders with their time priority and
# fill state, unsettled matches, the settlement batch in flight, dead nonces, cursors.
# Relative to engine/. Put it on a disk that survives restarts; back it up with the
# engine stopped (or copy the file together with its -wal file).
STORE_PATH=data/engine.sqlite
# Blocks a settlement transaction must be buried under before its fills are reported
# as confirmed (1 = as soon as it is mined).
CONFIRMATIONS=1
# On-chain cancels (cancelOrder / cancelAllOrders) are read by polling logs.
LOG_POLL_INTERVAL_MS=2000
# Largest block span per eth_getLogs query (lower it if the RPC provider limits ranges;
# the engine also halves it on its own when a query is refused).
LOG_MAX_BLOCK_RANGE=2000
# Log queries stop this many blocks short of the head, because an RPC backend that is
# slightly behind answers eth_getLogs with fewer logs and no error. The default in
# code is 2; it is 0 here because a local automine chain only produces a block when
# there is a transaction, so "head - 2" would never arrive.
LOG_HEAD_LAG_BLOCKS=0
# Blocks re-read on every pass (events are applied idempotently).
LOG_RESCAN_BLOCKS=5
# First block to scan for cancels when the store has no cursor yet. Default: the head
# at first start (an empty book has nothing to cancel).
# START_BLOCK=
# How often pause flag and index prices (price bands) are re-read from the chain.
CHAIN_REFRESH_MS=2000
# A trader with FAULT_THRESHOLD at-fault on-chain failures within FAULT_WINDOW_SEC
# gets new orders refused (HTTP 429) until the window has passed.
FAULT_THRESHOLD=3
FAULT_WINDOW_SEC=600
# Never sign a settlement transaction above this fee per gas (decimal gwei). A cap is
# on by default: uncapped bumping of a stuck transaction can outgrow the operator's
# balance. 0 switches it off.
MAX_FEE_PER_GAS_GWEI=100
# Upper bound for a settlement transaction's gas limit.
GAS_LIMIT_CAP=16000000
# The contract's per-match gas floor is BASE + PER_MARKET x marketCount (Exchange.sol:
# MATCH_GAS_BASE, MATCH_GAS_PER_MARKET). Every match in a batch is budgeted at it.
# Read from the contract at start-up when it exposes them; these are the fallback.
MATCH_GAS_FLOOR_BASE=400000
MATCH_GAS_FLOOR_PER_MARKET=200000
# How long to wait for a receipt before re-broadcasting, and how often to poll for it.
RECEIPT_TIMEOUT_MS=30000
RECEIPT_POLL_MS=500
# /health and the log warn when the operator has less ETH than this. The engine
# refuses to start with a balance of zero.
OPERATOR_MIN_BALANCE_ETH=0.01
# After a restart the engine reconciles its stored state with the chain before taking
# orders. If that is not done within this time (RPC down) the process exits non-zero.
RECOVERY_TIMEOUT_MS=120000
# Longest a POST /orders may wait for chain reads and for the trader's earlier
# submissions before it is refused (503 CHAIN_UNAVAILABLE, not accepted).
INTAKE_TIMEOUT_MS=8000
# Accepted submissions per trader address per minute (0 = unlimited), on top of the
# per-IP limit. Counted only for validly signed orders.
TRADER_ORDERS_PER_MINUTE=600
# A trader's free collateral and positions are reused for this long across submissions.
PRETRADE_CACHE_MS=1000
# On SIGTERM: stop taking orders, give the batch in flight this long, then exit.
SHUTDOWN_TIMEOUT_MS=30000
# info | warn | error | silent
LOG_LEVEL=info
# WebSocket connection limits.
WS_MAX_CONNECTIONS=1000
WS_MAX_CONNECTIONS_PER_IP=10

# --- keeper (npm run keeper) --------------------------------------------------
# Must be a different account than the operator (Hardhat account #1 below).
KEEPER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
KEEPER_POLL_INTERVAL_MS=5000
# The contract's funding interval; funding is called when lastFundingTime is this old.
FUNDING_INTERVAL_SEC=3600
# Warn at start-up if the keeper's free collateral in the Exchange (USDC units, 6
# decimals) is below this. Liquidating means taking the position over. 0 disables.
KEEPER_MIN_FREE_COLLATERAL=1
# Block to start scanning Fill/Liquidation events from when there is no saved state.
# Optional (0) on a local chain; REQUIRED on any other chain: the block in which the
# Exchange was deployed (the deployment file does not record it - look the deployment
# transaction up on the block explorer).
KEEPER_START_BLOCK=0
# Event cursor and tracked accounts, kept across restarts. Relative to engine/.
KEEPER_STATE_PATH=data/keeper-state.json
