# Arbitrum Sepolia (public testnet). Copy to .env.testnet.local, fill in, then:
#   npm run dev:testnet      (dev server)
#   npm run build:testnet    (static production build in dist/)
# All values are public: they end up in the JavaScript bundle. Never put keys here.

VITE_CHAIN_ID=421614
# Public URL of the matching engine (https; the WebSocket is derived as wss://<host>/ws).
VITE_ENGINE_URL=
# Optional: JSON-RPC endpoint for chain reads. Empty = Arbitrum's public Sepolia endpoint
# (rate-limited). A provider URL with an API key would be visible to every visitor.
VITE_RPC_URL=
# Required in production builds: from contracts/deployments/<network>.json after deploying.
VITE_EXCHANGE_ADDRESS=
# The USDC token the exchange was deployed with (Circle's test USDC on Arbitrum Sepolia).
VITE_USDC_ADDRESS=
