# Copy to .env.local and adjust. All values are public (they end up in the bundle).

# Matching engine REST/WS base URL.
VITE_ENGINE_URL=http://localhost:8080
# JSON-RPC endpoint used for chain reads. Empty = the chain's default
# (http://127.0.0.1:8545 locally, Arbitrum's public endpoint on 421614).
VITE_RPC_URL=http://127.0.0.1:8545
# Chain the exchange is deployed on: 31337 (local node; enables the "mint test USDC"
# button) or 421614 (Arbitrum Sepolia; see .env.testnet.example).
VITE_CHAIN_ID=31337
# Contract addresses. In `npm run dev` these may be left empty when
# ../contracts/deployments/<network>.json has an entry for VITE_CHAIN_ID (read automatically).
VITE_EXCHANGE_ADDRESS=
VITE_USDC_ADDRESS=
# Dev only: set to 1 to fake the engine API, chain reads and wallet (no backend needed).
VITE_MOCK=
