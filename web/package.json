{
  "name": "foxy-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "dev:testnet": "vite --mode testnet",
    "build": "tsc --noEmit && vite build",
    "build:testnet": "tsc --noEmit && vite build --mode testnet",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^2.58.4",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
